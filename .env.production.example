# ============================================
# Paper Bloom - Production Environment
# ============================================
# Copy this to your Coolify environment variables
# NEVER commit actual production values to Git!

# ============================================
# DATABASE (REQUIRED)
# ============================================
DATABASE_URL=postgres://usuario:senha@host:5432/paperbloom
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000

# ============================================
# MERCADO PAGO PRODUÇÃO (REQUIRED)
# ============================================
# ⚠️ IMPORTANTE: Use credenciais de PRODUÇÃO
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu_access_token_de_producao
MERCADOPAGO_PUBLIC_KEY=APP_USR-seu_public_key_de_producao
MERCADOPAGO_WEBHOOK_SECRET=seu_webhook_secret_de_producao

# ============================================
# APPLICATION (REQUIRED)
# ============================================
NEXT_PUBLIC_BASE_URL=https://paperbloom.com.br
NODE_ENV=production

# ============================================
# CLOUDFLARE R2 (REQUIRED)
# ============================================
R2_ACCOUNT_ID=seu_account_id
R2_ACCESS_KEY_ID=seu_access_key_id
R2_SECRET_ACCESS_KEY=seu_secret_access_key
R2_BUCKET_NAME=paperbloom-images
R2_ENDPOINT=https://seu_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://imagem.paperbloom.com.br

# ============================================
# RESEND EMAIL (REQUIRED)
# ============================================
# ⚠️ IMPORTANTE: Domínio deve estar verificado no Resend
RESEND_API_KEY=re_seu_api_key_de_producao
RESEND_FROM_EMAIL=noreply@paperbloom.com.br
RESEND_FROM_NAME=Paper Bloom

# ============================================
# UPLOAD (OPTIONAL)
# ============================================
MAX_IMAGE_SIZE=10485760
MAX_IMAGE_WIDTH=1920
MAX_IMAGE_HEIGHT=1080

# ============================================
# LOGGING (OPTIONAL)
# ============================================
LOG_LEVEL=info
